{
  "general": {
    "language": "en",
    "avatarPath": "",
    "muteSfx": false,
    "weatherInterval": 15,
    "weatherUnit": "metric"
  },
  "syspanel": {
    "clipExpandProgress": 0,
    "clipExpanded": false,
    "clipState": 1
  },
  "bar": {
    "position": "top",
    "width": 100,
    "height": 40,
    "opacity": 100,
    "style": "fill", 
    "time": {
      "format": "HH:mm:ss"
    },
    "autohide": false,
    "autohideTimeout": 1000,
    "modules": {
      "left": [
        "left",
        "workspaces",
        "media" 
      ],
     "center": [
        [
          "timedate",
          "info",
          "weather"
        ]
      ],      
     "right": [
        "tray",
        [
          "kb",
          "wifi",
          "bt",
          "vol",
          "bat"
        ]
      ]
    }
  },
  "theme": {
    "fontFamily": "Adwaita Mono",
    "borderRadius": 10,
    "activePreset": "Matugen",
    "matugen": true
  },
  "idle": {
    "enabled": true,
    "actions": {
      "dim": {
        "id": "dim",
        "timeout": 150,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "dpms": {
        "id": "dpms",
        "timeout": 450,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "lock": {
        "id": "lock",
        "timeout": 300,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      },
      "suspend": {
        "id": "suspend",
        "timeout": 600,
        "enabled": true,
        "respectInhibitors": true,
        "mprisInhibit": true,
        "command": "",
        "resumeCommand": "",
        "isCustom": false
      }
    }
  },
  "notifications": {
    "dnd": true,
    "position": "top right",
    "sound": true,
    "soundFile": ""
  },
  "display": {
    "monitors": {
      "eDP-1": {
        "enabled": false,
        "scale": 1
      }
    }
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "onTop": true,
    "elementSize": 44,
    "floating": false,
    "background": true,
    "exclusive": false,
    "autohide": false,
    "smartAutohide": true,
    "autohideTimeout": 1000,
    "editing": false,
    "apps": [
      {
        "name": "WezTerm",
        "comment": "Wez's Terminal Emulator",
        "desktop_id": "org.wezfurlong.wezterm.desktop",
        "icon": "org.wezfurlong.wezterm"
      },
      {
        "name": "Dolphin",
        "comment": "Manage your files",
        "desktop_id": "org.kde.dolphin.desktop",
        "icon": "org.kde.dolphin"
      }
    ],
    "overrideBoundsCorrection": false,
    "enableScrolling": false,
    "visibleElements": 7,
    "scrollingElements": 7,
    "maxVisibleElements": 7,
    "maxElements": 7,
    "hoverScale": 120,
    "cascadeScale": false,
    "focusRunning": true,
    "showRunningIndicators": true,
    "showRunningApps": false,
    "runningScope": "auto"
  }
