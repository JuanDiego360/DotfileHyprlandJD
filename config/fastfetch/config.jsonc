{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "small",
    "color": {
      "1": "#89b4fa",
      "2": "#74c7ec"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#cdd6f4"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#89b4fa"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#74c7ec"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#94e2d5"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
