# Plantilla de starship.toml: la genera matugen desde el fondo de pantalla.
# NO edites ~/.config/starship.toml a mano: se regenera con cada cambio de fondo
# (cambiarImagenPantalla). Edita ESTE archivo y vuelve a aplicar el fondo.

# Don't print a new line at the start of the prompt
add_newline = false

format = """
$cmd_duration$directory$git_branch$git_status$python$julia
$character"""

right_format = """$time"""

palette = "matugen"

# Paleta derivada del fondo por matugen (Material You).
# accent = acento principal · accent2 = azul · accent_soft = sage
# mint/mist/blue = acentos claros · deep = bloque oscuro de contraste
[palettes.matugen]
accent          = "{{colors.primary.default.hex}}"
on_accent       = "{{colors.on_primary.default.hex}}"
accent2         = "{{colors.tertiary.default.hex}}"
on_accent2      = "{{colors.on_tertiary.default.hex}}"
accent_soft     = "{{colors.secondary.default.hex}}"
on_accent_soft  = "{{colors.on_secondary.default.hex}}"
mint            = "{{colors.primary_fixed.default.hex}}"
on_mint         = "{{colors.on_primary_fixed.default.hex}}"
mist            = "{{colors.secondary_fixed.default.hex}}"
on_mist         = "{{colors.on_secondary_fixed.default.hex}}"
blue            = "{{colors.tertiary_fixed.default.hex}}"
on_blue         = "{{colors.on_tertiary_fixed.default.hex}}"
deep            = "{{colors.primary_container.default.hex}}"
on_deep         = "{{colors.on_primary_container.default.hex}}"
bad             = "{{colors.error.default.hex}}"
muted           = "{{colors.outline.default.hex}}"
text            = "{{colors.on_surface.default.hex}}"

[fill]
symbol = '-'
style = 'fg:muted'

# Replace the "❯" symbol in the prompt with "➜"
[character]                            # The name of the module we are configuring is "character"
success_symbol = "[  ](bold fg:accent)"
error_symbol = "[  ](bold fg:bad)"

# Disable the package module, hiding it from the prompt completely
[package]
disabled = true

[git_branch]
style = "bg:accent2"
symbol = "󰘬"
truncation_length = 12
truncation_symbol = ""
format = " 󰜥 [](bold fg:accent2)[$symbol $branch(:$remote_branch)](fg:on_accent2 bg:accent2)[ ](bold fg:accent2)"

[git_commit]
commit_hash_length = 4
tag_symbol = " "

[git_state]
format = '[\\($state( $progress_current of $progress_total)\\)]($style) '
cherry_pick = "[🍒 PICKING](bold bad)"

[git_status]
conflicted = " 🏳 "
ahead = " 🏎💨 "
behind = " 😰 "
diverged = " 😵 "
untracked = "[+$count](accent)"
stashed = " 📦 "
modified = "[±$count](accent2)"
staged = '[++\($count\)](accent)'
renamed = " ✍️ "
deleted = "[✘$count](bad)"

[hostname]
ssh_only = false
format =  "[•$hostname](bg:accent_soft bold fg:on_accent_soft)[](bold fg:accent2)"
trim_at = ".companyname.com"
disabled = false

[line_break]
disabled = false

[memory_usage]
disabled = true
threshold = -1
symbol = " "
style = "bold dimmed accent"

[time]
disabled = false
format = '[](bold fg:deep)[󱑎 $time](bold bg:deep fg:on_deep)[](bold fg:deep)'
time_format = "%H:%M"

[username]
style_user = "bold bg:accent_soft fg:on_accent_soft"
style_root = "bad bold"
format = "[](bold fg:accent2)[$user]($style)"
disabled = false
show_always = true

[directory]
home_symbol = " "
read_only = "  "
style = "bg:accent fg:on_accent"
truncation_length = 6
truncation_symbol = " ••/"
format = '[](bold fg:accent)[󰉋 $path]($style)[](bold fg:accent)'

[directory.substitutions]
"Desktop" = "  "
"Documents" = "  "
"Downloads" = "  "
"Music" = " 󰎈 "
"Pictures" = "  "
"Videos" = "  "
"GitHub" = " 󰊤 "

[cmd_duration]
min_time = 0
format = '[](bold fg:blue)[󰪢 $duration](bold bg:blue fg:on_blue)[](bold fg:blue)'

[python]
symbol = " "
style = "bg:mint fg:on_mint"
format = ' [](bold fg:mint)[$symbol$version( \($virtualenv\))](fg:on_mint bg:mint)[](bold fg:mint)'

[julia]
symbol = " "
style = "bg:mist fg:on_mist"
format = ' [](bold fg:mist)[$symbol$version](fg:on_mist bg:mist)[](bold fg:mist)'
