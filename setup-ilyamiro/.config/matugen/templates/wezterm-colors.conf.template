# Colores de WezTerm generados desde el fondo de pantalla (matugen).
# No editar a mano: se regenera con cada cambio de fondo.
# Plantilla: ~/.config/matugen/templates/wezterm-colors.conf.template
# Formato clave/valor en estilo kitty, que es el que parsea wezterm.lua.

foreground              {{colors.on_surface.default.hex}}
background              {{colors.surface.default.hex}}
cursor                  {{colors.primary.default.hex}}
selection_background    {{colors.secondary_container.default.hex}}
selection_foreground    {{colors.on_secondary_container.default.hex}}

# Los 16 colores ANSI: los usan starship, ls, eza, git, etc.
# Todos los acentos son tonos claros de la misma paleta, para que se lean
# sobre el fondo oscuro y no desentonen entre sí.

# black
color0 {{colors.surface_container_lowest.default.hex}}
color8 {{colors.outline.default.hex}}

# red
color1 {{colors.error.default.hex}}
color9 {{colors.on_error_container.default.hex}}

# green
color2  {{colors.primary.default.hex}}
color10 {{colors.on_primary_container.default.hex}}

# yellow
color3  {{colors.tertiary.default.hex}}
color11 {{colors.on_tertiary_container.default.hex}}

# blue
color4  {{colors.secondary.default.hex}}
color12 {{colors.on_secondary_container.default.hex}}

# magenta
color5  {{colors.secondary_fixed.default.hex}}
color13 {{colors.primary_fixed.default.hex}}

# cyan
color6  {{colors.primary_fixed.default.hex}}
color14 {{colors.tertiary_fixed.default.hex}}

# white
color7  {{colors.on_surface_variant.default.hex}}
color15 {{colors.on_surface.default.hex}}
